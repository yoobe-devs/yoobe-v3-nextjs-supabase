{
  "name": "yoobe-v3",
  "version": "3.1.0",
  "description": "Sistema completo de gestão de produtos e orçamentos com RBAC e multi-tenancy",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "dev:ngrok": "bash scripts/dev-with-ngrok.sh",
    "dev:ngrok:cloud": "bash scripts/dev-with-ngrok.sh --no-supabase",
    "seed:base-products": "node scripts/seed-base-products.js",
    "db:add-client-products-fk": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/sql/add-client-products-category-fk.sql",
    "db:reset-api-cache": "bash scripts/reset-api-cache.sh",
    "db:post-migrate": "npm run db:add-client-products-fk && npm run db:reset-api-cache",
    "db:add-store-sku-structure": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/sql/add-store-sku-structure.sql",
    "ngrok:check": "bash scripts/check-ngrok-status.sh",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:setup": "node scripts/setup-database.js",
    "db:seed": "node scripts/seed-database.js",
    "docs:gen": "node scripts/generate-docs.mjs",
    "docs:lint": "node scripts/lint-docs.mjs",
    "openapi:gen": "ts-node scripts/openapi-from-routes.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/supabase-js": "^2.38.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.294.0",
    "next": "14.0.3",
    "nodemailer": "^7.0.6",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.62.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.39.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/jest": "^29.5.8",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^8",
    "eslint-config-next": "14.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "supabase",
    "tailwindcss",
    "rbac",
    "multi-tenant",
    "ecommerce",
    "budget-management"
  ],
  "author": "Yoobe Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoobe-devs/yoobe-v3-nextjs-supabase.git"
  },
  "bugs": {
    "url": "https://github.com/yoobe-devs/yoobe-v3-nextjs-supabase/issues"
  },
  "homepage": "https://github.com/yoobe-devs/yoobe-v3-nextjs-supabase#readme"
}
