{
  "name": "yoobe-v3",
  "version": "3.3.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p ${PORT:-3000}",
    "lint": "next lint",
    "lint:ci": "next lint --max-warnings=0",
    "start": "next start -p ${PORT:-3000}",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -p tsconfig.rollback.json --noEmit",
    "audit:v33": "ts-node scripts/audit/v33.ts",
    "backup:db": "ts-node scripts/backup/db_dump.ts",
    "audit:rollback:v31": "ts-node scripts/audit/rollback_v31.ts",
    "audit:current-state": "ts-node scripts/audit/current_state.ts",
    "seed:users": "ts-node scripts/seed/users.ts",
    "monitor": "node scripts/ensure-system-availability.js",
    "dev:monitored": "npm run dev & npm run monitor",
    "health": "curl -s http://localhost:3000/api/system/health-public | jq .",
    "status": "curl -s http://localhost:3000/api/system/status | jq .",
    "smart-docs:init": "node scripts/init-smart-docs.js",
    "smart-docs:start": "ts-node scripts/start-smart-docs.js",
    "smart-docs:status": "curl -s http://localhost:3000/api/smart-docs/status | jq ."
