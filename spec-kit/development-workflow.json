  "workflow": {
    "phases": [
      {
        "id": "phase-planning",
        "title": "Planning Phase",
        "description": "Initial planning and specification creation",
        "steps": [
          "Analyze requirements and scope",
          "Create specification using /spec create",
          "Define acceptance criteria",
          "Assign priority and category",
          "Review with team if needed"
        ],
        "deliverables": [
          "Complete specification document",
          "Clear acceptance criteria",
          "Priority and category assignment"
        ]
      },
      {
        "id": "phase-development",
        "title": "Development Phase",
        "description": "Implementation and progress tracking",
        "steps": [
          "Start implementation",
          "Update progress using /spec track",
          "Mark acceptance criteria as completed",
          "Document any issues or blockers",
          "Regular progress updates"
        ],
        "deliverables": [
          "Working implementation",
          "Progress tracking updates",
          "Issue documentation"
        ]
      },
      {
        "id": "phase-testing",
        "title": "Testing Phase",
        "description": "Testing and validation",
        "steps": [
          "Test against acceptance criteria",
          "Verify all requirements are met",
          "Document test results",
          "Fix any issues found",
          "Update progress tracking"
        ],
        "deliverables": [
          "Tested implementation",
          "Test documentation",
          "Issue resolution"
        ]
      },
      {
        "id": "phase-approval",
        "title": "Approval Phase",
        "description": "Review and approval process",
        "steps": [
          "Request approval using /spec approve",
          "Address any feedback",
          "Make necessary changes",
          "Final review and approval",
          "Mark specification as completed"
        ],
        "deliverables": [
          "Approved implementation",
          "Feedback resolution",
          "Completed specification"
        ]
      },
      {
        "id": "phase-documentation",
        "title": "Documentation Phase",
        "description": "Update documentation and knowledge base",
        "steps": [
          "Update documentation using /spec docs",
          "Update changelog if applicable",
          "Update error prevention specifications",
          "Share knowledge with team",
          "Archive completed specification"
        ],
        "deliverables": [
          "Updated documentation",
          "Updated changelog",
          "Knowledge sharing"
        ]
      }
    ],
    "commands": {
      "planning": "/spec create",
      "tracking": "/spec track",
      "approval": "/spec approve",
      "documentation": "/spec docs",
      "bug_reporting": "/spec bug"
    },
    "integrations": {
      "error_prevention": "Check error prevention specifications before implementation",
      "documentation": "Auto-update documentation when specifications are completed",
      "monitoring": "Track metrics and insights for continuous improvement"
    }
  },
  "templates": {
    "feature_specification": {
      "title": "Feature: {feature_name}",
      "description": "Implementation of {feature_name} with {key_requirements}",
      "category": "feature",
      "priority": "medium",
      "requirements": [
        {
          "title": "Core Functionality",
          "description": "Implement core functionality for {feature_name}",
          "acceptanceCriteria": [
            "Feature works as specified",
            "All edge cases are handled",
            "Performance requirements are met"
          ]
        },
        {
          "title": "Testing",
          "description": "Comprehensive testing of {feature_name}",
          "acceptanceCriteria": [
            "Unit tests pass",
            "Integration tests pass",
            "Manual testing completed"
          ]
        },
        {
          "title": "Documentation",
          "description": "Document {feature_name} implementation",
          "acceptanceCriteria": [
            "API documentation updated",
            "User guide updated",
            "Code comments added"
          ]
        }
      ]
    },
    "bug_fix_specification": {
      "title": "Bug Fix: {bug_description}",
      "description": "Fix for {bug_description} affecting {affected_components}",
      "category": "bug-fix",
      "priority": "high",
      "requirements": [
        {
          "title": "Root Cause Analysis",
          "description": "Identify and document root cause of bug",
          "acceptanceCriteria": [
            "Root cause identified",
            "Impact analysis completed",
            "Prevention measures defined"
          ]
        },
        {
          "title": "Fix Implementation",
          "description": "Implement fix for identified bug",
          "acceptanceCriteria": [
            "Fix implemented",
            "Fix tested thoroughly",
            "No regression introduced"
          ]
        },
        {
          "title": "Prevention",
          "description": "Update error prevention specifications",
          "acceptanceCriteria": [
            "Error prevention updated",
            "Team notified of prevention measures",
            "Monitoring added if needed"
          ]
        }
      ]
    },
    "refactoring_specification": {
      "title": "Refactoring: {component_name}",
      "description": "Refactor {component_name} to improve {improvement_goals}",
      "category": "refactoring",
      "priority": "medium",
      "requirements": [
        {
          "title": "Analysis",
          "description": "Analyze current implementation and identify improvements",
          "acceptanceCriteria": [
            "Current issues identified",
            "Improvement opportunities documented",
            "Refactoring plan created"
          ]
        },
        {
          "title": "Implementation",
          "description": "Implement refactoring changes",
          "acceptanceCriteria": [
            "Refactoring completed",
            "Functionality preserved",
            "Code quality improved"
          ]
        },
        {
          "title": "Validation",
          "description": "Validate refactoring results",
          "acceptanceCriteria": [
            "All tests pass",
            "Performance maintained or improved",
            "Documentation updated"
          ]
        }
      ]
    }
