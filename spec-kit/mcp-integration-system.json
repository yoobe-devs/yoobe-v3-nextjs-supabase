  "unified_commands": {
    "spec_workflow": {
      "description": "Execute complete workflow using multiple MCP tools",
      "syntax": "/spec workflow <workflow_name> [options]",
      "examples": [
        "/spec workflow full_development --ai --test --deploy",
        "/spec workflow quick_fix --test-only",
        "/spec workflow feature_development --container --ai --e2e"
      ]
    },
    "spec_integrate": {
      "description": "Integrate specification with specific MCP tools",
      "syntax": "/spec integrate <tool_name> [specification_id]",
      "examples": [
        "/spec integrate docker my-feature-spec",
        "/spec integrate gemini error-prevention-spec",
        "/spec integrate playwright ui-spec"
      ]
    },
    "spec_sync": {
      "description": "Synchronize data across all MCP tools",
      "syntax": "/spec sync [--force] [--tool <tool_name>]",
      "examples": [
        "/spec sync",
        "/spec sync --force",
        "/spec sync --tool docker"
      ]
    },
    "spec_status": {
      "description": "Get status of all MCP tools and integrations",
      "syntax": "/spec status [--detailed]",
      "examples": ["/spec status", "/spec status --detailed"]
    }
  },
  "workflow_orchestration": {
    "full_development_workflow": {
      "name": "Full Development Workflow",
      "description": "Complete development workflow using all MCP tools",
      "steps": [
        {
          "step": 1,
          "tool": "gemini",
          "action": "Generate initial specification using AI",
          "command": "spec_ai_generate"
        },
        {
          "step": 2,
          "tool": "context7",
          "action": "Set development context",
          "command": "spec_context_set"
        },
        {
          "step": 3,
          "tool": "spec-kit",
          "action": "Create and track specification",
          "command": "spec create"
        },
        {
          "step": 4,
          "tool": "docker",
          "action": "Build test environment",
          "command": "spec_docker_build"
        },
        {
          "step": 5,
          "tool": "playwright",
          "action": "Generate and run tests",
          "command": "spec_test_ui"
        },
        {
          "step": 6,
          "tool": "gemini",
          "action": "AI review and optimization",
          "command": "spec_ai_review"
        },
        {
          "step": 7,
          "tool": "docker",
          "action": "Deploy to staging",
          "command": "spec_docker_deploy"
        },
        {
          "step": 8,
          "tool": "spec-kit",
          "action": "Approve and finalize",
          "command": "spec approve"
        }
      ]
    },
    "error_prevention_workflow": {
      "name": "Error Prevention Workflow",
      "description": "Workflow for implementing error prevention measures",
      "steps": [
        {
          "step": 1,
          "tool": "spec-kit",
          "action": "Identify error pattern",
          "command": "spec bug"
        },
        {
          "step": 2,
          "tool": "gemini",
          "action": "Analyze error and suggest prevention",
          "command": "spec_ai_predict"
        },
        {
          "step": 3,
          "tool": "context7",
          "action": "Set error prevention context",
          "command": "spec_context_set"
        },
        {
          "step": 4,
          "tool": "spec-kit",
          "action": "Create prevention specification",
          "command": "spec create"
        },
        {
          "step": 5,
          "tool": "playwright",
          "action": "Test prevention measures",
          "command": "spec_test_e2e"
        },
        {
          "step": 6,
          "tool": "docker",
          "action": "Deploy prevention to production",
          "command": "spec_docker_deploy"
        }
      ]
    }
  },
